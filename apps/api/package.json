{
	"name": "@codex-auth-ext/api",
	"type": "module",
	"exports": {
		".": "./dist/main.js",
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"default": "./dist/server.js"
		}
	},
	"scripts": {
		"start": "node dist/main.js",
		"build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run build:bundle",
		"build:bundle": "tsup",
		"clean": "rm -rf dist bundle",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@codex-auth-ext/shared": "workspace:*",
		"fastify": "~5.8.5"
	},
	"devDependencies": {
		"@types/node": "~22.15.35",
		"tsup": "~8.5.1",
		"typescript": "~5.7.0",
		"vitest": "~4.0.18"
	}
}
